# Copy this file to .env and change the values before going live.
PORT=6869

# MySQL — the database and tables are created automatically on first start.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=miss_india

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Long random string used to sign admin login tokens
JWT_SECRET=replace-with-a-long-random-string
