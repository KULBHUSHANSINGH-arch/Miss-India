# Miss India 2026 — goes in public_html/ next to index.html.
#   /api/*      → PHP backend (server/index.php)
#   /uploads/*  → uploaded photos & blog media (static files)
#   everything else → the React app (index.html)

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS once an SSL certificate is active (uncomment after SSL works).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pass the admin login token (Authorization header) through to PHP.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Backend code, .env and private documents are never served directly.
  RewriteCond %{THE_REQUEST} \s/+server(/|\s|\?) [NC]
  RewriteRule ^ - [F,L]

  # API → PHP
  RewriteRule ^api(/.*)?$ server/index.php [L,QSA]

  # Real files (JS, CSS, images, uploads) are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React routes (/register, /admin, /blog/…) → index.html
  RewriteRule ^(?!api|uploads) index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Built JS/CSS have a hash in their name → cache for a year. index.html is always re-checked.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
