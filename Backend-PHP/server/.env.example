# Copy this file to .env (in this same "server" folder) and fill in the values.
# Same keys as the Node backend's Backend/.env.

# MySQL — on Hostinger: hPanel → Databases → MySQL Databases.
# The tables are created automatically on the first request.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-mysql-password
DB_NAME=miss_india

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Long random string used to sign admin login tokens
JWT_SECRET=replace-with-a-long-random-string
