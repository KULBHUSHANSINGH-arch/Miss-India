# Only index.php may be reached (through /api/…). .env, source code, logs and
# private documents (ID proofs, payment screenshots) are never downloadable.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <Files "index.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "index.php">
    Allow from all
  </Files>
</IfModule>
